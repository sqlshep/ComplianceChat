# ComplianceChat — environment configuration (PLACEHOLDERS ONLY — do not put real secrets here)
# Copy to .env and fill in. .env is gitignored. No AWS keys belong in any of these files;
# authenticate via the AWS default credential provider chain (IAM Identity Center / SSO).

# ---- AWS core ----
AWS_REGION=us-east-1
# Application runtime profile (least-privilege; ideally an IAM Identity Center/SSO profile)
AWS_PROFILE=<app-runtime-profile>
# Ingestion profile — use a SEPARATE profile/role from the app where practical
AWS_PROFILE_INGEST=<ingestion-profile>

# ---- S3 ----
S3_SOURCE_BUCKET=<source-documents-bucket>
S3_EXTRACTED_BUCKET=<extracted-json-bucket>
S3_EVIDENCE_BUCKET=<decision-evidence-bucket>

# ---- DynamoDB ----
DDB_CONTROLS_TABLE=<controls-table>
DDB_RATES_TABLE=<rates-table>
DDB_DECISIONS_TABLE=<decisions-table>

# ---- OpenSearch Serverless ----
AOSS_COLLECTION_ENDPOINT=https://<collection-id>.<region>.aoss.amazonaws.com
AOSS_INDEX=compliance-chunks

# ---- Bedrock ----
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIM=1024
BEDROCK_GENERATION_MODEL_ID=<generation-inference-profile-id>
BEDROCK_EVAL_MODEL_ID=<evaluation-inference-profile-id>
BEDROCK_GUARDRAIL_ID=<guardrail-id>
BEDROCK_GUARDRAIL_VERSION=<guardrail-version>

# ---- Local servers (bind to localhost only) ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8787
FRONTEND_PORT=5173
